<Window x:Class="Scp603.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCP-603 — симулятор самовозобновляющейся программы"
        Height="720" Width="1180"
        Background="#FF12161A"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#FF1B2127">
            <MenuItem Header="Объект">
                <MenuItem Header="Запустить" Click="OnStartClick"/>
                <MenuItem Header="Остановить" Click="OnStopClick"/>
                <Separator/>
                <MenuItem Header="Вывести новую версию" Click="OnGenerateVersionClick"/>
                <MenuItem Header="Скомпилировать файлы Морфика…" Click="OnCompileClick"/>
                <Separator/>
                <MenuItem Header="Выход" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="Сцены" x:Name="ScenesMenu"/>
            <MenuItem Header="Справка">
                <MenuItem Header="О симуляции" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#FF1B2127" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Запустить" Padding="12,4" Margin="0,0,6,0" Click="OnStartClick"/>
                <Button Content="Остановить" Padding="12,4" Margin="0,0,6,0" Click="OnStopClick"/>
                <Button Content="+ Версия" Padding="12,4" Margin="0,0,6,0" Click="OnGenerateVersionClick"/>
                <Button Content="Скомпилировать…" Padding="12,4" Margin="0,0,18,0" Click="OnCompileClick"/>
                <TextBlock Text="Приближение (мс на число):" Foreground="#FF9AA0A6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="DelayBox" Width="60" Text="0" VerticalContentAlignment="Center"/>
                <TextBlock Text="  Автооткрытие окон:" Foreground="#FF9AA0A6" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <CheckBox x:Name="AutoWindowCheck" VerticalAlignment="Center" IsChecked="False"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#FF1B2127" Foreground="#FFCFD8DC">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="VersionStatus" Text="версия 1"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: main thread output -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ОСНОВНОЙ ПОТОК — генерация простых чисел" Foreground="#FF80CBC4" FontWeight="Bold" Margin="2,0,0,6"/>

                <Border Grid.Row="1" Background="Black" BorderBrush="#FF37474F" BorderThickness="1">
                    <TextBox x:Name="PrimeLog"
                             FontFamily="Consolas" FontSize="13"
                             Background="Black" Foreground="#FF69F0AE"
                             BorderThickness="0"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </Border>

                <TextBlock Grid.Row="2" x:Name="WindowHint" Foreground="#FFFFD54F" Margin="2,8,0,0" TextWrapping="Wrap"/>

                <StackPanel Grid.Row="3" Margin="2,8,0,0">
                    <TextBlock x:Name="ProfileText" Foreground="#FF9AA0A6" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#FF263238"/>

            <!-- Right: the SCP-603 window (scene preview + interaction) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="SceneTitle" Text="ОКНО SCP-603 — сцена не выбрана" Foreground="#FF80CBC4" FontWeight="Bold" Margin="2,0,0,6"/>

                <Border Grid.Row="1" Background="Black" BorderBrush="#FF37474F" BorderThickness="1">
                    <Image x:Name="SceneImage" Stretch="Uniform"
                           MouseDown="OnSceneMouseDown"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="InputBox" FontFamily="Consolas" FontSize="14"
                             VerticalContentAlignment="Center" KeyDown="OnInputKeyDown"/>
                    <Button Grid.Column="1" Content="Отправить" Padding="12,4" Margin="6,0,0,0" Click="OnSendClick"/>
                    <Button Grid.Column="2" Content="Enter" Padding="12,4" Margin="6,0,0,0" Click="OnEnterKeyClick"/>
                </Grid>

                <TextBlock Grid.Row="3" x:Name="SceneHint" Foreground="#FF9AA0A6" Margin="2,6,0,0" TextWrapping="Wrap" FontSize="11"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
