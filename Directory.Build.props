<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>1.0.0</Version>
    <Authors>Foundation Simulation Team</Authors>
    <Product>SCP-603 Simulator</Product>
    <Description>Safe, ethical simulation of SCP-603 (self-regenerating prime emitting program).</Description>
    <!-- No third-party packages are used anywhere in this solution. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
